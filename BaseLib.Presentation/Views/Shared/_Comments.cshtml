@model ScoreDetailPage
@{
    ViewData["CommentCategory"] = Model.Card.Key;
    ViewData["CommentProgramId"] = Model.Department.Id;
}
<section aria-label="Yorumlar" class="mt-10">
    <h2 class="mb-4 text-xl font-bold text-navy-900">Yorumlar</h2>
    @if (TempData["CommentSuccess"] is string message)
    {
        <p role="status" class="mb-4 rounded-xl bg-teal-50 p-4 text-teal-700">@message</p>
    }
    <div asp-validation-summary="All" role="alert"></div>
    <partial name="_CommentForm" model='@(new CommentFormModel("new-comment", Model.Card.Key, Model.Department.Id))' />
    @if (Model.Comments.Count == 0)
    {
        <p class="mt-5 text-sm text-muted-foreground">Henüz yayımlanmış yorum yok.</p>
    }
    <ul class="mt-5">
        @foreach (var comment in Model.Comments)
        {
            <partial name="_Comment" model="comment" />
        }
    </ul>
</section>
