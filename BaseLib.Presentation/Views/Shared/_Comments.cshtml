@model IReadOnlyList<SiteComment>
<section aria-label="Yorumlar" data-comments class="mt-10">

    <div class="mb-4 flex items-end justify-between border-b border-border pb-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-700">Topluluk</p>
            <h2 class="mt-1 text-xl font-bold text-navy-900">Yorumlar <span data-comment-count class="text-muted-foreground">
            </span>
            </h2>
        </div>
        <span class="hidden text-xs text-muted-foreground sm:block">Saygılı ve yapıcı olun.</span>
    </div>
    <partial name="_CommentForm" model='@("new-comment")' />
    <p data-comment-status role="status" class="mt-2 text-sm text-teal-700">
    </p>

    <ul data-comment-list class="mt-5">
        @foreach(var comment in Model) {
        <partial name="_Comment" model="comment" />
        }
    </ul>
</section>
<template id="comment-template">
    <li data-comment class="relative mt-4">
        <article class="rounded-xl border border-border bg-white p-4 shadow-sm">
            <header class="flex items-center gap-2">
                <span data-avatar class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-100 text-xs font-bold text-navy-700">
                </span>
                <div>
                    <span data-author class="block text-sm font-semibold text-navy-800">
                    </span>
                    <span class="text-xs text-muted-foreground">şimdi</span>
                </div>
            </header>
            <div data-body class="comment-body mt-3 whitespace-pre-wrap text-sm leading-6 text-navy-900">
            </div>
            <div class="mt-3 flex items-center gap-4 text-xs">
                <button type="button" data-like data-likes="0" aria-pressed="false" class="text-muted-foreground">♥ Beğen <span>0</span>
                </button>
            </div>
        </article>
    </li>
</template>
