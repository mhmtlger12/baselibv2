@model string
@inject ISiteContentService Site
@{
    var position = Context.Request.Path == "/" ? "home" : "sidebar";
    var ads = (await Site.GetAsync(Context.RequestAborted)).Ads.Where(x => x.Position == position && !string.IsNullOrWhiteSpace(x.ImageUrl));
}
@foreach (var ad in ads)
{
    <aside class="overflow-hidden rounded-xl border border-border bg-white @Model" aria-label="Reklam">
        @if (!string.IsNullOrWhiteSpace(ad.LinkUrl))
        {
            <a href="@ad.LinkUrl" rel="sponsored noopener" class="block h-full"><img src="@ad.ImageUrl" alt="@ad.Name" loading="lazy" class="h-full w-full object-cover" /></a>
        }
        else
        {
            <img src="@ad.ImageUrl" alt="@ad.Name" loading="lazy" class="h-full w-full object-cover" />
        }
    </aside>
}
