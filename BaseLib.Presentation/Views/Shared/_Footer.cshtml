<footer class="mt-14 border-t-2 border-teal-400 bg-navy-900 text-navy-100">

    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-11 sm:px-6 lg:grid-cols-[1.15fr_1.7fr] lg:gap-16">

        <section aria-label="puannokta hakkında">

            <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-500 text-lg font-bold text-white">p.</span>
                <div>
                    <p class="font-bold tracking-tight text-white">puannokta</p>
                    <p class="text-xs text-navy-300">Taban puanları, tek noktada.</p>
                </div>
            </div>

            <div class="mt-5 h-px w-12 bg-teal-400">
            </div>
            <p class="mt-3 max-w-sm text-sm leading-6 text-navy-200">KPSS, YKS, ALES ve DGS için güncel taban puanlarını güvenle karşılaştır, tercihine yön ver.</p>

            <div class="mt-5 flex gap-2" aria-label="Sosyal medya">
                @foreach (var social in new[] { (Icon: "facebook", Name: "Facebook"), (Icon: "twitter-x", Name: "X"), (Icon: "youtube", Name: "YouTube"), (Icon: "instagram", Name: "Instagram") })
                {
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10">
                        <img src="@Url.Content($"~/icons/social/{social.Icon}.svg")" alt="@social.Name" width="16" height="16" class="h-4 w-4" />
                    </span>
                }
            </div>

        </section>

        <nav aria-label="Alt menü" class="grid gap-8 sm:grid-cols-2">

            <div>
                <h2 class="text-sm font-semibold text-white">Puan Kategorileri</h2>
                <div class="mt-4 border-t border-white/10">
                    @foreach(var item in new[] {("/taban-puanlari/kpss-lisans","KPSS"),("/taban-puanlari/yks","YKS"),("/bilgi/ales","ALES"),("/taban-puanlari/dgs","DGS")}) {
                    <a href="@item.Item1" class="flex items-center gap-2 border-b border-white/10 py-2.5 text-sm text-navy-200 hover:text-white">
                    <span aria-hidden="true" class="text-teal-400">→</span>@item.Item2 Taban Puanları</a>
                    }

                </div>
            </div>

            <div>
                <h2 class="text-sm font-semibold text-white">Site Hakkında</h2>
                <div class="mt-4 border-t border-white/10">
                    @foreach(var item in new[] {("/bilgi/hakkimizda","Hakkımızda"),("/bilgi/gizlilik","Gizlilik Politikası"),("/iletisim","İletişim"),("/bilgi/kullanim-kosullari","Kullanım Koşulları")}) {
                    <a href="@item.Item1" class="flex items-center gap-2 border-b border-white/10 py-2.5 text-sm text-navy-200 hover:text-white">
                    <span aria-hidden="true" class="text-teal-400">→</span>@item.Item2</a>
                    }

                </div>
            </div>

        </nav>

    </div>

    <div class="border-t border-white/10">
        <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-4 text-xs text-navy-300 sm:flex-row sm:justify-between sm:px-6">
            <p>© @DateTime.Now.Year puannokta. Tüm hakları saklıdır.</p>
            <p>Veriler ÖSYM ve kurum duyurularından derlenir.</p>
        </div>
    </div>
</footer>
