@model string
<form data-comment-form class="mt-4 rounded-2xl border border-border bg-white p-4 sm:p-5">

    <div class="mb-4 flex items-center gap-3">
        <span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-full bg-teal-100 font-semibold text-teal-700">✎</span>
        <div>
            <h3 class="font-semibold text-navy-900">Düşünceni paylaş</h3>
            <p class="text-xs text-muted-foreground">Yapıcı yorumlar tercih sürecini kolaylaştırır.</p>
        </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
        <div>
            <label for="@Model-name" class="field-label">Adın soyadın</label>
            <input id="@Model-name" name="name" required maxlength="100" placeholder="Örn. Ayşe Yılmaz" class="input" />
        </div>
        <div>
            <label for="@Model-email" class="field-label">E-posta adresin</label>
            <input id="@Model-email" name="email" type="email" required maxlength="254" placeholder="ornek@mail.com" class="input" />
        </div>
    </div>
    <label class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
    <input type="checkbox" name="hideName" class="h-4 w-4 accent-teal-600" />Adım soyadım yorumda yıldızlanarak gizlensin.</label>
    <label id="@Model-body-label" class="field-label mt-3">Yorumun</label>
    <div class="overflow-hidden rounded-xl border border-border">
        <div class="flex gap-1 border-b border-border bg-navy-50/70 px-2 py-1.5" role="toolbar" aria-label="Yazı düzenleme araçları">
            <button type="button" data-format="bold" aria-label="Kalın yaz" class="h-7 w-7 font-bold">B</button>
            <button type="button" data-format="italic" aria-label="İtalik yaz" class="h-7 w-7 italic">I</button>
            <button type="button" data-format="insertUnorderedList" aria-label="Madde işaretli liste" class="h-7 w-7">☷</button>
        </div>
        <div contenteditable="true" role="textbox" aria-multiline="true" aria-required="true" aria-labelledby="@Model-body-label" data-editor data-placeholder="Yorumunu yaz..." class="editor-content min-h-28 px-3 py-2.5 text-sm outline-none">
        </div>
    </div>
    <button type="submit" class="mt-3 rounded-lg bg-navy-700 px-4 py-2 text-sm font-semibold text-white">Yorumu gönder</button>
</form>
