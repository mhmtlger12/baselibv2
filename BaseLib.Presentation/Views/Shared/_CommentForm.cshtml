@model CommentFormModel
@{
    var draft = ViewData["CommentDraft"] as Baselib.Business.DTOs.SendCommentDto;
    if (draft?.ParentId != Model.ParentId) draft = null;
}
<form asp-controller="Scores" asp-action="Comment" asp-route-category="@Model.Category" asp-route-id="@Model.ProgramId" method="post" class="mt-4 rounded-2xl border border-border bg-white p-4 sm:p-5">
    <input type="hidden" name="ParentId" value="@Model.ParentId" />
    <h3 class="mb-3 font-semibold text-navy-900">Düşünceni paylaş</h3>
    <div class="grid gap-3 sm:grid-cols-2">
        <div>
            <label for="@Model.FormId-name" class="field-label">Adın soyadın</label>
            <input id="@Model.FormId-name" name="Author" value="@draft?.Author" required maxlength="100" class="input" />
        </div>
        <div>
            <label for="@Model.FormId-email" class="field-label">E-posta adresin</label>
            <input id="@Model.FormId-email" name="Email" value="@draft?.Email" type="email" required maxlength="254" class="input" />
        </div>
    </div>
    <label class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
        <input type="checkbox" name="HideName" value="true" checked="@(draft?.HideName == true)" class="h-4 w-4 accent-teal-600" />Adım yorumda gizlensin.
    </label>
    <label for="@Model.FormId-body" class="field-label mt-3">Yorumun</label>
    <textarea id="@Model.FormId-body" name="Body" required maxlength="4000" rows="4" class="input">@draft?.Body</textarea>
    <p class="mt-2 text-xs text-muted-foreground">E-posta adresiniz yayımlanmaz. Yorumlar onaylandıktan sonra görünür.</p>
    <button type="submit" class="btn mt-3">Yorumu gönder</button>
</form>
