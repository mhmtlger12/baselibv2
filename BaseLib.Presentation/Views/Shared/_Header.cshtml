<header class="sticky top-0 z-30 border-b border-border bg-white/90 backdrop-blur">

    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6">

        <div class="flex items-center gap-4 lg:gap-6">
            <a href="/" class="flex shrink-0 items-center gap-3 text-left" aria-label="puannokta ana sayfa">
            <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-navy-600 to-teal-600 text-base font-bold text-white shadow-sm">p.</span>
            <span class="leading-tight">
            <span class="block text-lg font-bold tracking-tight text-navy-900">puannokta</span>
            <span class="hidden text-xs text-muted-foreground lg:block">Taban puanları, tek noktada.</span>
            </span>
            </a>

            <nav aria-label="Ana menü" class="hidden lg:block">
                <partial name="_SiteNavigation" />
            </nav>

            <form action="/arama" method="get" role="search" class="ml-auto hidden w-64 items-center rounded-full border border-border bg-navy-50 px-4 py-2 lg:flex">
                <label for="site-search-desktop" class="sr-only">Site içi arama</label>
                <input id="site-search-desktop" name="q" type="search" placeholder="Site içi arama..." class="w-full bg-transparent text-sm outline-none" />
                <button type="submit" aria-label="Ara">⌕</button>

            </form>
            <a href="/Admin" class="hidden shrink-0 rounded-full border border-border px-3 py-1.5 text-xs font-medium text-navy-500 hover:bg-teal-50 lg:inline-flex">panel</a>
            <button type="button" data-toggle="mobile-menu" aria-controls="mobile-menu" aria-expanded="false" aria-label="Menüyü aç veya kapat" class="ml-auto rounded-md border border-border p-2 text-navy-700 lg:hidden">☰</button>

        </div>

        <div id="mobile-menu" hidden class="pt-3 lg:hidden">

            <nav aria-label="Mobil ana menü">
                <partial name="_SiteNavigation" />
            </nav>

            <form action="/arama" role="search" method="get" class="mt-3 flex gap-2">
                <label for="mobile-search" class="sr-only">Site içi arama</label>
                <input class="input" id="mobile-search" name="q" type="search" placeholder="Site içi arama..." />
                <button class="btn" type="submit">Ara</button>
            </form>
            <a href="/Admin" class="mt-3 block rounded-lg border border-border p-2 text-center text-sm">Yönetim Paneli</a>

        </div>

    </div>
</header>
