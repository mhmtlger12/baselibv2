@model SiteComment
<li class="relative mt-4">
    <article class="rounded-xl border border-border bg-white p-4 shadow-sm">
        <header class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-100 text-xs font-bold text-navy-700">@(Model.Author.Length > 0 ? Model.Author[..1] : "?")</span>
            <div><span class="block text-sm font-semibold text-navy-800">@Model.Author</span><span class="text-xs text-muted-foreground">@Model.Time</span></div>
        </header>
        <div class="mt-3 whitespace-pre-wrap text-sm leading-6 text-navy-900">@Model.Body</div>
        <div class="mt-3 flex items-center gap-4 text-xs">
            <span class="text-muted-foreground">@Model.Likes beğeni</span>
            <button type="button" data-toggle="reply-@Model.Id" aria-controls="reply-@Model.Id" aria-expanded="false" class="text-muted-foreground">Yanıtla</button>
        </div>
        <div id="reply-@Model.Id" hidden>
            <partial name="_CommentForm" model='@(new CommentFormModel("reply-form-" + Model.Id, (string)ViewData["CommentCategory"]!, (int)ViewData["CommentProgramId"]!, Model.Id))' />
        </div>
    </article>
    <ul class="ml-4 border-l-2 border-teal-200 pl-4 sm:ml-7 sm:pl-6">
        @foreach (var reply in Model.Replies)
        {
            <partial name="_Comment" model="reply" />
        }
    </ul>
</li>
