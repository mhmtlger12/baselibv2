@inject ISiteContentService Site
<ul class="site-navigation-list flex flex-wrap items-center gap-1 text-sm font-medium">
    @foreach (var item in (await Site.GetAsync(Context.RequestAborted)).NavLinks)
    {
    <li>
        <a href="@item.Url" class="block rounded-md px-3 py-2 text-navy-700 hover:bg-teal-50 hover:text-teal-700" aria-current="@(Context.Request.Path == item.Url ? "page" : null)">@item.Label</a>
    </li>
    }
</ul>
