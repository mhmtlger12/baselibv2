@model JobsPage
@inject ISiteContentService Site
@{ ViewData["Title"] = Model.Title + " – Kamu Personel Alımı"; }
<div class="job-page mx-auto max-w-6xl px-4 py-6 sm:px-6">

    <nav aria-label="Konum" class="job-breadcrumb mb-5 text-sm text-muted-foreground">
        <a href="/">Ana Sayfa</a>
        <span aria-hidden="true"> › </span>
        <span aria-current="page" class="text-navy-800">İlanlar</span>
    </nav>

    <div class="grid gap-6 lg:grid-cols-[19rem_1fr]">

        <aside class="lg:sticky lg:top-20 lg:self-start">
            <div class="job-filter overflow-hidden rounded-2xl border border-border bg-white shadow-sm">

                <form method="get" role="search" class="border-b border-border p-3">
                    <input type="hidden" name="category" value="@Model.Category" />
                    <div class="job-search flex items-center gap-2 rounded-xl border border-border bg-navy-50 px-3 py-2">
                        <label for="job-query" class="sr-only">İlan ara</label>
                        <input id="job-query" name="q" value="@Model.Query" type="search" placeholder="Kurum / Kuruluş Adı" class="w-full bg-transparent text-sm text-navy-900 outline-none" />
                        <button type="submit" aria-label="İlan ara">⌕</button>
                    </div>
                </form>

                <nav aria-label="İlan kategorileri" class="p-2">
                    <ul class="space-y-0.5">
                        @foreach(var category in Site.Content.JobCategories) {
                        <li>
                        @if(category.Children?.Count > 0) {
                            <div class="job-category-link flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-semibold uppercase tracking-wide">
                            <span class="job-category-name">
                                <span class="job-category-icon" aria-hidden="true">
                                    <partial name="~/Areas/Admin/Views/Shared/_Icon.cshtml" model='@(category.Key switch { "all" => "dashboard", "memur" => "users", "sozlesmeli" => "briefcase", "akademik" => "image", "isci" => "key", "askeri" => "roles", "yargi" => "key", _ => "layers" })' />
                                </span>
                                @category.Label
                            </span>
                            <span class="text-[10px]">@Site.Jobs(category.Key, null).Jobs.Count</span>
                            </div>
                        }
                        else {
                            <a asp-route-category="@category.Key" asp-route-q="@Model.Query" class="job-category-link flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-semibold uppercase tracking-wide @(Model.Category == category.Key ? "is-active" : "")" aria-current="@(Model.Category == category.Key ? "page" : null)">
                            <span class="job-category-name">
                                <span class="job-category-icon" aria-hidden="true">
                                    <partial name="~/Areas/Admin/Views/Shared/_Icon.cshtml" model='@(category.Key switch { "all" => "dashboard", "memur" => "users", "sozlesmeli" => "briefcase", "akademik" => "image", "isci" => "key", "askeri" => "roles", "yargi" => "key", _ => "layers" })' />
                                </span>
                                @category.Label
                            </span>
                            <span class="text-[10px]">@Site.Jobs(category.Key, null).Jobs.Count</span>
                            </a>
                        }
                            @if(category.Children?.Count > 0) {
                            <ul class="ml-3 space-y-0.5 border-l border-navy-100 pl-2">
                                    @foreach(var child in category.Children) {
                                    <li>
                                        <a asp-route-category="@child.Key" asp-route-q="@Model.Query" class="job-child-link flex items-center justify-between rounded-lg px-3 py-1.5 text-[13px] @(Model.Category == child.Key ? "is-active" : "")" aria-current="@(Model.Category == child.Key ? "page" : null)">@child.Label<span class="text-[10px] text-navy-400">@Site.Jobs(child.Key, null).Jobs.Count</span>
                                        </a>
                                    </li>
                                    }
                                </ul>
                            }

                        </li>
                        }

                    </ul>
                </nav>

            </div>
            <div class="mt-6 hidden lg:block">
                <partial name="_Ad" model='@("h-64")' />
            </div>
        </aside>

        <div>
            <div class="job-heading mb-7 flex items-end justify-between border-b-2 border-teal-500/70 pb-3">
                <h1 class="flex items-center gap-3 text-xl font-bold uppercase tracking-wide text-navy-900"><span class="job-home-icon" aria-hidden="true">⌂</span>@Model.Title</h1>
                <span class="job-count text-sm font-semibold">@Model.Jobs.Count ilan</span>
            </div>
            @if(Model.Jobs.Count == 0) {
            <p class="rounded-2xl border border-dashed border-border bg-white px-6 py-16 text-center text-sm text-muted-foreground">Bu kritere uygun ilan bulunamadı.</p>
            }

            <div class="space-y-8">
                @foreach(var group in Model.Jobs.GroupBy(x => x.PublishedAt)) {
                <section aria-label="@group.Key.ToString("d MMMM yyyy")" class="grid grid-cols-[3.5rem_1fr] gap-3 sm:grid-cols-[5rem_1fr] sm:gap-5">
                    <div class="job-date pt-1 text-right">
                        <p class="text-3xl font-extrabold leading-none sm:text-4xl">@group.Key.Day</p>
                        <p class="mt-1 text-xs font-medium uppercase tracking-wide">@group.Key.ToString("MMMM")</p>
                    </div>
                    <div class="job-stream relative space-y-3 border-l-2 border-navy-100 pl-4 sm:pl-6">
                        <span aria-hidden="true" class="job-node absolute -left-[7px] top-2 h-3 w-3 rounded-full border-2 bg-white">
                        </span>
                        @foreach(var job in group) {
                        <a href="/ilanlar/@job.Id" class="job-card group flex items-start gap-4 rounded-2xl border border-border bg-white p-4 shadow-sm transition-all">
                        <span aria-hidden="true" class="job-card-accent"></span>
                        @if (!string.IsNullOrWhiteSpace(job.InstitutionLogoUrl)) { <img src="@job.InstitutionLogoUrl" alt="@job.Institution logosu" class="job-avatar h-11 w-11 shrink-0 rounded-xl object-contain p-1" /> } else { <span aria-hidden="true" class="job-avatar flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xs font-bold">@SiteStyle.Initials(job.Institution)</span> }
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-start justify-between gap-2">
                                <h2 class="text-sm font-bold uppercase leading-snug text-navy-900 group-hover:text-indigo-700">@job.Institution</h2>
                                <span class="job-badge badge">@job.CategoryLabel</span>
                            </div>
                            <p class="mt-3 text-sm text-navy-600">@job.Summary</p>
                            <div class="job-card-footer mt-4 flex items-center justify-between border-t pt-3">
                                <span class="job-card-date text-xs font-semibold">@job.StartDate - @job.EndDate</span>
                                <span class="job-card-link text-xs font-bold">İlanı incele <span aria-hidden="true">→</span></span>
                            </div>
                        </div>
                        </a>
                        }

                    </div>
                </section>
                }
            </div>

        </div>

    </div>
</div>
