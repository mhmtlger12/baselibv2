@model JobsPage
@inject ISiteContentService Site
@{ ViewData["Title"] = Model.Title + " – Kamu Personel Alımı"; }
<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6">

    <nav aria-label="Konum" class="mb-4 text-sm text-muted-foreground">
        <a href="/">Ana Sayfa</a>
        <span aria-hidden="true"> › </span>
        <span aria-current="page" class="text-navy-800">İlanlar</span>
    </nav>

    <div class="grid gap-6 lg:grid-cols-[19rem_1fr]">

        <aside class="lg:sticky lg:top-20 lg:self-start">
            <div class="overflow-hidden rounded-2xl border border-border bg-white shadow-sm">

                <form method="get" role="search" class="border-b border-border p-3">
                    <input type="hidden" name="category" value="@Model.Category" />
                    <div class="flex items-center gap-2 rounded-xl border border-border bg-navy-50 px-3 py-2">
                        <label for="job-query" class="sr-only">İlan ara</label>
                        <input id="job-query" name="q" value="@Model.Query" type="search" placeholder="Kurum / Kuruluş Adı" class="w-full bg-transparent text-sm text-navy-900 outline-none" />
                        <button type="submit" aria-label="İlan ara">⌕</button>
                    </div>
                </form>

                <nav aria-label="İlan kategorileri" class="p-2">
                    <ul class="space-y-0.5">
                        @foreach(var category in Site.Content.JobCategories) {
                        <li>
                            <a asp-route-category="@category.Key" asp-route-q="@Model.Query" class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-semibold uppercase tracking-wide @(Model.Category == category.Key ? "bg-teal-600 text-white" : "text-navy-700 hover:bg-teal-50")" aria-current="@(Model.Category == category.Key ? "page" : null)">
                            <span>@category.Label</span>
                            <span class="text-[10px]">@Site.Jobs(category.Key, null).Jobs.Count</span>
                            </a>
                            @if(category.Children?.Count > 0) {
                            <details open="@(category.Key == "akademik" || category.Children.Any(x => x.Key == Model.Category))">
                                <summary class="ml-3 px-3 py-1 text-xs text-navy-500">Alt kategoriler
                                </summary>
                                <ul class="ml-3 space-y-0.5 border-l border-navy-100 pl-2">
                                    @foreach(var child in category.Children) {
                                    <li>
                                        <a asp-route-category="@child.Key" asp-route-q="@Model.Query" class="flex items-center justify-between rounded-lg px-3 py-1.5 text-[13px] @(Model.Category == child.Key ? "bg-teal-50 font-semibold text-teal-700" : "text-navy-600 hover:bg-navy-50")" aria-current="@(Model.Category == child.Key ? "page" : null)">@child.Label<span class="text-[10px] text-navy-400">@Site.Jobs(child.Key, null).Jobs.Count</span>
                                        </a>
                                    </li>
                                    }
                                </ul>
                            </details>
                            }

                        </li>
                        }

                    </ul>
                </nav>

            </div>
            <div class="mt-6 hidden lg:block">
                <partial name="_Ad" model='@("h-64")' />
            </div>
        </aside>

        <div>
            <div class="mb-6 flex items-end justify-between border-b-2 border-teal-500/70 pb-3">
                <h1 class="text-xl font-bold uppercase tracking-wide text-navy-900">⌂ @Model.Title</h1>
                <span class="text-sm font-semibold text-teal-600">@Model.Jobs.Count ilan</span>
            </div>
            @if(Model.Jobs.Count == 0) {
            <p class="rounded-2xl border border-dashed border-border bg-white px-6 py-16 text-center text-sm text-muted-foreground">Bu kritere uygun ilan bulunamadı.</p>
            }

            <div class="space-y-8">
                @foreach(var group in Model.Jobs.GroupBy(x => x.PublishedAt)) {
                <section aria-label="@group.Key.ToString("d MMMM yyyy")" class="grid grid-cols-[3.5rem_1fr] gap-3 sm:grid-cols-[5rem_1fr] sm:gap-5">
                    <div class="pt-1 text-right">
                        <p class="text-3xl font-extrabold leading-none text-navy-800 sm:text-4xl">@group.Key.Day</p>
                        <p class="mt-1 text-xs font-medium uppercase tracking-wide text-teal-600">@group.Key.ToString("MMMM")</p>
                    </div>
                    <div class="relative space-y-3 border-l-2 border-navy-100 pl-4 sm:pl-6">
                        <span aria-hidden="true" class="absolute -left-[7px] top-2 h-3 w-3 rounded-full border-2 border-teal-500 bg-white">
                        </span>
                        @foreach(var job in group) {
                        <a href="/ilanlar/@job.Id" class="group flex items-start gap-4 rounded-2xl border border-border bg-white p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:border-teal-300 hover:shadow-md">
                        <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-navy-600 to-teal-600 text-xs font-bold text-white">@SiteStyle.Initials(job.Institution)</span>
                        <div class="min-w-0 flex-1">
                            <h2 class="text-sm font-bold uppercase leading-snug text-navy-900 group-hover:text-teal-700">@job.Institution</h2>
                            <p class="mt-1 text-sm text-navy-600">@job.Summary <span class="font-semibold italic text-amber-600">(@job.StartDate - @job.EndDate)</span>
                            </p>
                            <span class="badge mt-2">@job.CategoryLabel</span>
                        </div>
                        </a>
                        }

                    </div>
                </section>
                }
            </div>

        </div>

    </div>
</div>
