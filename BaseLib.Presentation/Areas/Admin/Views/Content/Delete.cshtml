@model ContentEditModel
@{ ViewData["Title"] = "Kaydı Sil"; ViewData["CancelUrl"] = Url.Action("Index", new { slug = Model.Slug }); }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="_DialogHeader" />
    <form asp-action="Delete" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" method="post">
        <div class="px-6 py-5">
            <p>@Model.Definition.Title içindeki bu kaydı silmek istediğinize emin misiniz?</p>
        </div>
        <div class="flex justify-end gap-2 border-t border-navy-100 px-6 py-4">
            <a href="@ViewData["CancelUrl"]" class="btn-soft">İptal</a>
            <button class="btn bg-rose-600 hover:bg-rose-700">Sil</button>
        </div>
    </form>
</dialog>
