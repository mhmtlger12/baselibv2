@model UserEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni Kullanıcı" : "Kullanıcı Düzenle"; }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="_DialogHeader" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="px-6 py-5">
            <div asp-validation-summary="All" role="alert">
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="field-label">Ad</label>
                    <input asp-for="FirstName" type="text" class="input" maxlength="100" />
                    <span asp-validation-for="FirstName">
                    </span>
                </div>
                <div>
                    <label asp-for="LastName" class="field-label">Soyad</label>
                    <input asp-for="LastName" type="text" class="input" maxlength="100" />
                    <span asp-validation-for="LastName">
                    </span>
                </div>
                <div>
                    <label asp-for="Username" class="field-label">Kullanıcı Adı</label>
                    <input asp-for="Username" aria-describedby="Username-hint Username-error" type="text" class="input" required minlength="3" maxlength="100" />
                    <p id="Username-hint" class="mt-1 text-xs text-muted-foreground">3–100 karakter olmalıdır.</p>
                    <span asp-validation-for="Username" id="Username-error"></span>
                </div>
                <div>
                    <label asp-for="Email" class="field-label">E-posta</label>
                    <input asp-for="Email" type="email" class="input" required maxlength="254" />
                    <span asp-validation-for="Email">
                    </span>
                </div>
                <div>
                    <label asp-for="Phone" class="field-label">Telefon</label>
                    <input asp-for="Phone" type="tel" class="input" maxlength="32" />
                    <span asp-validation-for="Phone">
                    </span>
                </div>
                <div>
                    <label asp-for="DepartmentId" class="field-label">Departman</label>
                    <select asp-for="DepartmentId" class="input">
                    <option value="">Seçiniz</option>
                    @foreach(var item in Model.Departments) {
                    <option value="@item.Id">@item.Name</option>
                    }</select>
                </div>
                <div class="sm:col-span-2">
                    <div>
                        <label asp-for="Password" class="field-label">Şifre</label>
                        <input asp-for="Password" aria-describedby="Password-hint Password-error" type="password" class="input" autocomplete="new-password" minlength="12" maxlength="128" required="@(Model.Id == 0)" />
                        <p id="Password-hint" class="mt-1 text-xs text-muted-foreground">@(Model.Id == 0 ? "En az 12 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir." : "Boş bırakırsanız mevcut şifre korunur. Girerseniz en az 12 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.")</p>
                        <span asp-validation-for="Password" id="Password-error"></span>
                    </div>
                </div>
                <fieldset class="sm:col-span-2">
                    <legend class="field-label">Roller
                    </legend>
                    <div class="flex flex-wrap gap-4">
                        @foreach(var role in Model.AvailableRoles) {
                        <label class="inline-flex items-center gap-2 text-sm text-navy-700">
                        <input type="checkbox" name="RoleIds" value="@role.Id" checked="@Model.RoleIds.Contains(role.Id)" class="h-5 w-5 accent-teal-600" />@role.Name</label>
                        }
                    </div>
                </fieldset>
                @if(Model.Id > 0) {
                <div class="sm:col-span-2">
                    <label class="flex items-center gap-2 text-sm text-navy-700">
                    <input asp-for="IsActive" class="h-5 w-5 accent-teal-600" />Hesap aktif</label>
                </div>
                }
            </div>

        </div>
        <partial name="_DialogFooter" />

    </form>
</dialog>
