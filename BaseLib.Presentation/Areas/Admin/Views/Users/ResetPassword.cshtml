@model UserPasswordResetModel
@{ ViewData["Title"] = "Kullanıcı Şifresini Sıfırla"; ViewData["CancelUrl"] = Url.Action("Edit", new { id = Model.Id }); }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="_DialogHeader" />
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
        <div class="space-y-4 px-6 py-5">
            <div asp-validation-summary="All" role="alert"></div>
            <p class="text-sm text-navy-700"><strong>@Model.Username</strong> hesabı için yeni şifre belirleyin.</p>
            <div>
                <label asp-for="NewPassword" class="field-label">Yeni şifre</label>
                <input asp-for="NewPassword" type="password" class="input" autocomplete="new-password" minlength="12" maxlength="128" required aria-describedby="password-hint" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div>
                <label asp-for="Confirmation" class="field-label">Yeni şifre tekrar</label>
                <input asp-for="Confirmation" type="password" class="input" autocomplete="new-password" minlength="12" maxlength="128" required />
                <span asp-validation-for="Confirmation"></span>
            </div>
            <p id="password-hint" class="text-xs text-muted-foreground">En az 12 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</p>
            <p class="text-sm text-navy-700">Bu işlem için şifre sıfırlama yetkisi gerekir. Ayrıcalıklı hesaplarda ek izin aranır.</p>
        </div>
        <partial name="_DialogFooter" />
    </form>
</dialog>
