@model BaseLib.Presentation.Areas.Admin.Models.InstitutionEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni Kurum" : "Kurumu Düzenle"; }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="~/Areas/Admin/Views/Shared/_DialogHeader.cshtml" />
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post"><div class="px-6 py-5"><div asp-validation-summary="All" role="alert"></div><div class="space-y-4">
        <div><label asp-for="Name" class="field-label">Kurum adı</label><input asp-for="Name" class="input" maxlength="200" /></div>
        <div><label asp-for="LogoUrl" class="field-label">Logo URL</label><input asp-for="LogoUrl" class="input" maxlength="2048" placeholder="https://.../logo.png" /></div>
        <div><label asp-for="WebsiteUrl" class="field-label">Web sitesi</label><input asp-for="WebsiteUrl" class="input" maxlength="2048" placeholder="https://..." /></div>
        <label class="flex items-center gap-2 text-sm text-navy-700"><input asp-for="IsActive" class="h-5 w-5 accent-teal-600" /> Aktif</label>
    </div></div><partial name="~/Areas/Admin/Views/Shared/_DialogFooter.cshtml" /></form>
</dialog>
