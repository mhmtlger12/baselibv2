@model List<MenuDto>
@{ ViewData["Title"] = "Menüler"; }
<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="text-xl font-bold">Menüler</h2>
        <p class="mt-1 text-sm text-muted-foreground">Panel menülerini, sıralamayı, hiyerarşiyi ve bağlı izinleri yönetin.</p>
    </div>
    <a asp-action="Edit" class="btn">
    <partial name="_Icon" model='@("plus")' />Yeni Menü</a>
</div>
<div class="panel divide-y divide-navy-50 p-2">
    @foreach(var item in Model.OrderBy(x => x.Order)) {
    <div class="flex flex-wrap items-center gap-3 rounded-xl px-3 py-3 hover:bg-navy-50">
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-teal-50 font-mono text-xs font-semibold text-teal-700">@item.Order</span>
        <div class="min-w-0">
            <div class="flex items-center gap-2">
                <span class="font-semibold text-navy-900">@item.Name</span>
                <partial name="_Status" model="item.IsActive" />
            </div>
            <span class="font-mono text-xs text-navy-400">@item.Url</span>
        </div>
        <div class="ml-auto hidden items-center gap-2 sm:flex">
            @if(item.ParentId.HasValue) {
            <span class="badge badge-muted">Alt menü</span>
            }<span class="badge badge-admin">@(item.PermissionCode ?? "İzin yok")</span>
        </div>
        <partial name="_RowActions" model="item.Id" />
    </div>
    }
    @if(Model.Count == 0) {
    <p class="p-8 text-center text-muted-foreground">Kayıt bulunamadı.</p>
    }
</div>
