@model BaseLib.Presentation.Areas.Admin.Models.JobListingEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni İlan" : "İlanı Düzenle"; ViewData["CancelUrl"] = Url.Action("Index"); }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-3xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="~/Areas/Admin/Views/Shared/_DialogHeader.cshtml" />
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div class="px-6 py-5"><div asp-validation-summary="All" role="alert"></div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2"><label asp-for="InstitutionId" class="field-label">Kurum / Kuruluş</label><select asp-for="InstitutionId" class="input"><option value="">Kurum seçin</option>@foreach (var institution in Model.Institutions) { <option value="@institution.Id">@institution.Name</option> }</select><input asp-for="Institution" type="hidden" /></div>
                <div class="sm:col-span-2"><label asp-for="Summary" class="field-label">İlan Özeti</label><input asp-for="Summary" class="input" maxlength="500" /></div>
                <div><label asp-for="CategoryKey" class="field-label">Kategori Anahtarı</label><input asp-for="CategoryKey" class="input" placeholder="akademik-uye" /></div>
                <div><label asp-for="CategoryLabel" class="field-label">Kategori Adı</label><input asp-for="CategoryLabel" class="input" /></div>
                <div><label asp-for="PublishedAt" class="field-label">Yayın Tarihi</label><input asp-for="PublishedAt" type="date" class="input" /></div>
                <div><label asp-for="StartDate" class="field-label">Başvuru Başlangıcı</label><input asp-for="StartDate" class="input" /></div>
                <div><label asp-for="EndDate" class="field-label">Başvuru Bitişi</label><input asp-for="EndDate" class="input" /></div>
                <div class="sm:col-span-2"><label asp-for="SourceUrl" class="field-label">Kaynak İlan URL</label><input asp-for="SourceUrl" class="input" maxlength="2048" /></div>
                <div class="sm:col-span-2"><label asp-for="PdfUrl" class="field-label">İlan PDF URL</label><input asp-for="PdfUrl" class="input" maxlength="2048" /></div>
                <label class="flex items-center gap-2 text-sm text-navy-700"><input asp-for="IsActive" class="h-5 w-5 accent-teal-600" /> Aktif</label>
            </div>
        </div>
        <partial name="~/Areas/Admin/Views/Shared/_DialogFooter.cshtml" />
    </form>
</dialog>
