@model BaseLib.Presentation.Areas.Admin.Models.DeleteModel
@{ ViewData["Title"] = "İlanı Sil"; }
<dialog open class="w-full max-w-md rounded-2xl border border-navy-100 bg-white p-6 shadow-2xl">
    <h2 class="text-lg font-bold text-navy-900">İlanı silmek istiyor musunuz?</h2>
    <p class="mt-2 text-sm text-muted-foreground">@Model.Name</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-6 flex justify-end gap-2">
        <a asp-action="Index" class="btn-soft">Vazgeç</a><button type="submit" class="btn bg-rose-600 text-white">Sil</button>
    </form>
</dialog>
