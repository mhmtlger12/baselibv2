@model List<SettingDto>
@{ ViewData["Title"] = "Sistem Ayarları"; }
<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="text-xl font-bold tracking-tight text-navy-900">Sistem Ayarları</h2>
        <p class="mt-1 max-w-2xl text-sm text-muted-foreground">Tanımlı sistem ayarlarını yönetin.</p>
    </div>
</div>
<div asp-validation-summary="All">
</div>
<div class="panel overflow-hidden" data-filter-table>
    <partial name="_TableSearch" />
    <div class="overflow-x-auto">
        <table class="admin-table">
            <caption class="sr-only">Sistem Ayarları
            </caption>
            <thead>
                <tr>
                    <th scope="col">Anahtar
                    </th>
                    <th scope="col">Değer
                    </th>
                    <th scope="col">Açıklama
                    </th>
                    <th scope="col">İşlem
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model) {
                <tr data-row>
                    <td>
                        <code class="font-mono text-xs font-semibold text-teal-700">@item.Key</code>
                    </td>
                    <td class="max-w-md truncate" title="@item.Value">@item.Value
                    </td>
                    <td>@item.Description
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-button" aria-label="Ayarı düzenle">
                        <partial name="_Icon" model='@("edit")' />
                        </a>
                    </td>
                </tr>
                }
                <tr data-empty hidden="@(Model.Count > 0)">
                    <td colspan="4" class="text-center">Kayıt bulunamadı.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
