@model ProfileModel
@{ ViewData["Title"] = "Profilim"; }
<div class="mb-5">
    <h2 class="text-xl font-bold">Hesap Ayarları</h2>
    <p class="mt-1 text-sm text-muted-foreground">Profiliniz, rolleriniz ve güvenlik ayarlarınız.</p>
</div>
<div class="grid grid-cols-1 gap-4 lg:grid-cols-[340px_1fr]">

    <section class="panel h-fit p-6">
        <div class="flex flex-col items-center text-center">
            <span class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-navy-600 to-teal-500 text-2xl font-bold text-white">@SiteStyle.Initials(string.IsNullOrEmpty(Model.User.FullName) ? Model.User.Username : Model.User.FullName)</span>
            <h3 class="mt-4 text-lg font-bold">@Model.User.FullName</h3>
            <p class="text-sm text-muted-foreground">@Model.User.Email</p>
            <div class="mt-3 flex flex-wrap justify-center gap-1.5">
                @foreach(var role in Model.User.Roles) {
                <span class="badge @(role == Model.User.ActiveRoleName ? "" : "badge-admin")">@role @(role == Model.User.ActiveRoleName ? "• aktif" : "")</span>
                }
            </div>
        </div>

        <dl class="mt-6 divide-y divide-navy-50 text-sm">
            @foreach(var item in new[] {("Kullanıcı Adı",Model.User.Username),("Departman",Model.User.DepartmentName ?? "—"),("Aktif Rol",Model.User.ActiveRoleName ?? "—"),("Kayıt Tarihi",Model.User.CreatedDate.ToString("d MMM yyyy"))}) {
            <div class="flex items-center justify-between py-3">
                <dt class="text-muted-foreground">@item.Item1
                </dt>
                <dd class="font-semibold text-navy-900">@item.Item2
                </dd>
            </div>
            }
        </dl>
    </section>

    <div class="space-y-4">
        @if(Model.User.RoleIds.Count > 1) {
        <section class="panel p-6">
            <h3 class="text-base font-bold">Rollerim</h3>
            <p class="mt-1 text-sm text-muted-foreground">Hangi rol ile devam edeceğinizi seçebilirsiniz.</p>
            <ul class="mt-4 space-y-2">
                @for(var i = 0; i < Math.Min(Model.User.Roles.Count, Model.User.RoleIds.Count); i++) { var id = Model.User.RoleIds[i]; var active = id == Model.User.ActiveRoleId;

                <li class="flex items-center gap-3 rounded-xl border px-4 py-3 @(active ? "border-teal-300 bg-teal-50/60" : "border-navy-100")">
                    <span class="text-teal-600">
                    <partial name="_Icon" model='@("roles")' />
                    </span>
                    <span class="font-semibold">@Model.User.Roles[i]</span>
                    <div class="ml-auto">
                        @if(active) {
                        <span class="badge">Aktif Rol</span>
                        } else {
                        <form asp-action="SwitchRole" method="post">
                            <input type="hidden" name="roleId" value="@id" />
                            <button class="btn-soft">Bu rol ile gir</button>
                        </form>
                        }
                    </div>
                </li>
                }
            </ul>
        </section>
        }

        <section class="panel p-6">
            <h3 class="text-base font-bold">Güvenlik Ayarları</h3>
            <div class="mt-4 flex items-start gap-3 rounded-xl bg-teal-50 p-4 text-sm text-teal-800">
                <partial name="_Icon" model='@("lock")' />
                <p>Hesabınızın güvenliği için şifrenizi düzenli olarak değiştirmeniz önerilir.</p>
            </div>

            <form asp-action="Password" method="post" class="mt-5 space-y-4">
                <div asp-validation-summary="All" role="alert">
                </div>

                <div>
                    <label asp-for="Password.CurrentPassword" class="field-label">Mevcut Şifre</label>
                    <input asp-for="Password.CurrentPassword" type="password" autocomplete="current-password" required class="input" maxlength="128" />
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="Password.NewPassword" class="field-label">Yeni Şifre</label>
                        <input asp-for="Password.NewPassword" aria-describedby="Password-NewPassword-hint Password-NewPassword-error" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="input" />
                        <p id="Password-NewPassword-hint" class="mt-1 text-xs text-muted-foreground">En az 12 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</p>
                        <span asp-validation-for="Password.NewPassword" id="Password-NewPassword-error"></span>
                    </div>
                    <div>
                        <label asp-for="Password.Confirmation" class="field-label">Yeni Şifre (Tekrar)</label>
                        <input asp-for="Password.Confirmation" aria-describedby="Password-Confirmation-hint Password-Confirmation-error" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="input" />
                        <p id="Password-Confirmation-hint" class="mt-1 text-xs text-muted-foreground">Yeni şifreyle birebir eşleşmelidir.</p>
                        <span asp-validation-for="Password.Confirmation" id="Password-Confirmation-error"></span>
                    </div>
                </div>

                <div class="flex justify-end">
                    <button class="btn" data-saving-text="Güncelleniyor…">Şifreyi Güncelle</button>
                </div>

            </form>

        </section>

    </div>
</div>
