@model List<PermissionDto>
@{ ViewData["Title"] = "İzinler"; ViewData["SearchPlaceholder"] = "İzin kodu, controller, action…"; }
<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="text-xl font-bold tracking-tight text-navy-900">İzinler</h2>
        <p class="mt-1 max-w-2xl text-sm text-muted-foreground">Controller izinlerini işlem seviyesinde yönetin.</p>
    </div>
    <a asp-action="Edit" class="btn">
    <partial name="_Icon" model='@("plus")' />Yeni İzin</a>
</div>
<div asp-validation-summary="All">
</div>
<div class="panel overflow-hidden" data-filter-table>
    <partial name="_TableSearch" />
    <div class="overflow-x-auto">
        <table class="admin-table">
            <caption class="sr-only">İzinler
            </caption>
            <thead>
                <tr>
                    <th scope="col">Adı
                    </th>
                    <th scope="col">İzin Kodu
                    </th>
                    <th scope="col">Controller
                    </th>
                    <th scope="col">Action
                    </th>
                    <th scope="col">CRUD
                    </th>
                    <th scope="col">Durum
                    </th>
                    <th scope="col">İşlemler
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model) {
                <tr data-row>
                    <td class="font-medium">@item.Name
                    </td>
                    <td>
                        <code class="rounded-md bg-navy-50 px-2 py-1 font-mono text-xs text-teal-700">@item.Code</code>
                    </td>
                    <td>@item.ControllerName
                    </td>
                    <td>@item.ActionName
                    </td>
                    <td>
                        <span class="badge badge-admin">@item.CRUDActionType</span>
                    </td>
                    <td>
                        <partial name="_Status" model="item.IsActive" />
                    </td>
                    <td>
                        <partial name="_RowActions" model="item.Id" />
                    </td>
                </tr>
                }
                <tr data-empty hidden="@(Model.Count > 0)">
                    <td colspan="7" class="text-center">Kayıt bulunamadı.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
