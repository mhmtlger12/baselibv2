@model PermissionEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni İzin" : "İzin Düzenle"; }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="_DialogHeader" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="px-6 py-5">
            <div asp-validation-summary="All" role="alert">
            </div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="field-label">İzin Adı</label>
                    <input asp-for="Name" placeholder="Kullanıcı Listele" aria-describedby="Name-hint Name-error" type="text" class="input" required maxlength="150" />
                    <p id="Name-hint" class="mt-1 text-xs text-muted-foreground">Panelde kullanıcıya gösterilecek açıklayıcı izin adı.</p>
                    <span asp-validation-for="Name" id="Name-error"></span>
                </div>
                <div>
                    <label asp-for="Code" class="field-label">İzin Kodu</label>
                    <input asp-for="Code" aria-describedby="Code-hint Code-error" type="text" class="input font-mono" required maxlength="150" pattern="[A-Za-z][A-Za-z0-9_]*" spellcheck="false" autocomplete="off" placeholder="Users_Read" />
                    <p id="Code-hint" class="mt-1 text-xs text-muted-foreground">Endpoint üzerindeki <code class="rounded bg-rose-50 px-1.5 py-0.5 font-mono font-semibold text-rose-700 ring-1 ring-inset ring-rose-200">RequirePermission</code> koduyla birebir aynı olmalıdır.</p>
                    <span asp-validation-for="Code" id="Code-error"></span>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label asp-for="ControllerName" class="field-label">Controller Adı</label>
                        <input asp-for="ControllerName" placeholder="Users" aria-describedby="ControllerName-hint ControllerName-error" type="text" class="input" required maxlength="100" />
                        <p id="ControllerName-hint" class="mt-1 text-xs text-muted-foreground">Endpoint'in bulunduğu API controller adı.</p>
                        <span asp-validation-for="ControllerName" id="ControllerName-error"></span>
                    </div>
                    <div>
                        <label asp-for="ActionName" class="field-label">Action Adı</label>
                        <input asp-for="ActionName" placeholder="Index" aria-describedby="ActionName-hint ActionName-error" type="text" class="input" required maxlength="100" />
                        <p id="ActionName-hint" class="mt-1 text-xs text-muted-foreground">Controller içindeki action/metot adı.</p>
                        <span asp-validation-for="ActionName" id="ActionName-error"></span>
                    </div>
                </div>
                <div>
                    <label asp-for="CRUDActionType" class="field-label">CRUD İşlem Tipi</label>
                    <select asp-for="CRUDActionType" aria-describedby="CRUDActionType-hint CRUDActionType-error" class="input">
                    @foreach(var item in new[] {(1,"View"),(2,"Add"),(3,"Update"),(4,"Preview"),(5,"Option"),(6,"Delete")}) {
                    <option value="@item.Item1">@item.Item2</option>
                    }</select>
                    <p id="CRUDActionType-hint" class="mt-1 text-xs text-muted-foreground">İznin temsil ettiği işlem türünü seçin.</p>
                    <span asp-validation-for="CRUDActionType" id="CRUDActionType-error"></span>
                </div>
                <div>
                    <label asp-for="Description" class="field-label">Açıklama</label>
                    <textarea asp-for="Description" aria-describedby="Description-hint Description-error" rows="3" class="input" maxlength="500">
                    </textarea>
                    <p id="Description-hint" class="mt-1 text-xs text-muted-foreground">Bu iznin ne amaçla kullanıldığını açıklayın.</p>
                    <span asp-validation-for="Description" id="Description-error"></span>
                </div>
                <label class="flex items-center gap-2 text-sm text-navy-700">
                <input asp-for="IsActive" class="h-5 w-5 accent-teal-600" />Aktif</label>
            </div>

        </div>
        <partial name="_DialogFooter" />

    </form>
</dialog>
