@model List<RoleDto>
@{ ViewData["Title"] = "Roller"; }
<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="text-xl font-bold">Roller</h2>
        <p class="mt-1 text-sm text-muted-foreground">Rollere bağlı izinleri controller bazlı düzenleyin.</p>
    </div>
    <a asp-action="Edit" class="btn">
    <partial name="_Icon" model='@("plus")' />Yeni Rol</a>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    @foreach(var item in Model) {
    <section class="panel flex flex-col p-5">
        <div class="flex items-start justify-between">
            <div>
                <h3 class="text-base font-bold text-navy-900">@item.Name</h3>
                <p class="mt-0.5 text-sm text-muted-foreground">@item.Description</p>
            </div>
            <partial name="_Status" model="item.IsActive" />
        </div>
        <p class="mt-4 text-lg font-bold text-navy-900">@item.Permissions.Count</p>
        <p class="text-xs text-muted-foreground">İzin</p>
        <div class="mt-4 flex gap-2 border-t border-navy-50 pt-4">
            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-button" aria-label="Rolü düzenle">
            <partial name="_Icon" model='@("edit")' />
            </a>
            @if(!item.IsSystemRole) {
            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-button icon-delete" aria-label="Rolü sil">
            <partial name="_Icon" model='@("trash")' />
            </a>
            }
        </div>
    </section>
    }
</div>
@if(Model.Count == 0) {
<p class="panel p-8 text-center text-muted-foreground">Kayıt bulunamadı.</p>
}
