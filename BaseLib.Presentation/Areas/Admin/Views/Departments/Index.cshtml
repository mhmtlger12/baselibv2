@model List<DepartmentDto>
@{ ViewData["Title"] = "Departmanlar"; }
<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
    <div>
        <h2 class="text-xl font-bold">Departmanlar</h2>
        <p class="mt-1 text-sm text-muted-foreground">Organizasyon ağacını ve departman hiyerarşisini yönetin.</p>
    </div>
    <a asp-action="Edit" class="btn">
    <partial name="_Icon" model='@("plus")' />Yeni Departman</a>
</div>
<div class="panel p-3">
    <ul>
        @foreach(var node in DepartmentTree.Build(Model)) {
        <partial name="_DepartmentNode" model="node" />
        }
    </ul>
    @if(Model.Count == 0) {
    <p class="p-8 text-center text-muted-foreground">Kayıt bulunamadı.</p>
    }
</div>
