@model DepartmentEditModel
@{ ViewData["Title"] = Model.Id == 0 ? "Yeni Departman" : "Departman Düzenle"; }
<dialog open data-edit-dialog aria-labelledby="edit-title" class="w-full max-w-xl rounded-2xl border border-navy-100 bg-white p-0 shadow-2xl">
    <partial name="_DialogHeader" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="px-6 py-5">
            <div asp-validation-summary="All" role="alert">
            </div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="field-label">Departman Adı</label>
                    <input asp-for="Name" aria-describedby="Name-hint Name-error" type="text" class="input" required maxlength="150" />
                    <p id="Name-hint" class="mt-1 text-xs text-muted-foreground">En fazla 150 karakter.</p>
                    <span asp-validation-for="Name" id="Name-error"></span>
                </div>
                <div>
                    <label asp-for="Code" class="field-label">Departman Kodu</label>
                    <input asp-for="Code" aria-describedby="Code-hint Code-error" type="text" class="input" required maxlength="50" />
                    <p id="Code-hint" class="mt-1 text-xs text-muted-foreground">Departmanı tanımlayan kısa kod; en fazla 50 karakter.</p>
                    <span asp-validation-for="Code" id="Code-error"></span>
                </div>
                <div>
                    <label asp-for="ParentDepartmentId" class="field-label">Üst Departman</label>
                    <select asp-for="ParentDepartmentId" aria-describedby="ParentDepartmentId-hint ParentDepartmentId-error" class="input">
                    <option value="">Üst departman yok (Root)</option>
                    @foreach(var item in Model.Departments) {
                    <option value="@item.Id">@item.Name</option>
                    }</select>
                    <p id="ParentDepartmentId-hint" class="mt-1 text-xs text-muted-foreground">Seçmezseniz kök departman olarak oluşturulur.</p>
                    <span asp-validation-for="ParentDepartmentId" id="ParentDepartmentId-error"></span>
                </div>
                <label class="flex items-center gap-2 text-sm text-navy-700">
                <input asp-for="IsActive" class="h-5 w-5 accent-teal-600" />Aktif</label>
            </div>

        </div>
        <partial name="_DialogFooter" />

    </form>
</dialog>
