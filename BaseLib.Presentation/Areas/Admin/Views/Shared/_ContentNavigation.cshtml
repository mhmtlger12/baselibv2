@{ var current = Context.Request.Path.Value ?? ""; }
<details open="@(current.Contains("/Content/", StringComparison.OrdinalIgnoreCase))">

    <summary class="nav-link">
        <span class="text-navy-300">
        <partial name="_Icon" model='@("layers")' />
        </span>
        <span class="flex-1">İçerik Yönetimi</span>
        <partial name="_Icon" model='@("chevron")' />
    </summary>

    <div class="ml-4 space-y-1">
        @foreach(var item in new[] {("slider","Slider","image"),("ads","Reklam Alanları","ad"),("countdowns","Sınav Sayaçları","clock")}) {
        <a href="/Admin/Content/@item.Item1" class="nav-link" aria-current="@(current.Contains("/Content/" + item.Item1) ? "page" : null)">
        <partial name="_Icon" model="item.Item3" />@item.Item2</a>
        }
        @foreach(var group in new[] {
        ("Sidebarlar", new[] { ("sidebar-recent","Son Eklenenler"),("sidebar-osym","ÖSYM Duyuruları") }),
        ("Taban Puanları", new[] { ("score-cards","Kategori Kartları"),("departments","Bölümler"),("taban-kpss","KPSS"),("taban-dgs","DGS"),("taban-yks","YKS") }),
        ("İlanlar", new[] { ("jobs","İlan Listesi"),("job-categories","Kategoriler") }),
        ("Kurumlar", new[] { ("institutions","Kurum Yönetimi") }) }) {
        <details open="@(group.Item2.Any(x => x.Item1 switch { "jobs" => current.StartsWith("/Admin/Jobs", StringComparison.OrdinalIgnoreCase), "institutions" => current.StartsWith("/Admin/Institutions", StringComparison.OrdinalIgnoreCase), _ => current.Contains("/Content/" + x.Item1) }))">
            <summary class="nav-link">
                <partial name="_Icon" model='@(group.Item1 switch { "Sidebarlar" => "layers", "Taban Puanları" => "dashboard", "İlanlar" => "briefcase", "Kurumlar" => "users", _ => "menu" })' />@group.Item1
            </summary>
            <div class="ml-4">
                @foreach(var child in group.Item2) {
                    <a href="@(child.Item1 switch { "jobs" => "/Admin/Jobs", "institutions" => "/Admin/Institutions", _ => "/Admin/Content/" + child.Item1 })" class="nav-link" aria-current="@(child.Item1 switch { "jobs" => current.StartsWith("/Admin/Jobs", StringComparison.OrdinalIgnoreCase), "institutions" => current.StartsWith("/Admin/Institutions", StringComparison.OrdinalIgnoreCase), _ => current.Contains("/Content/" + child.Item1) })">
                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-navy-400">
                </span>@child.Item2</a>
                }
            </div>
        </details>
        }
        <a href="/Admin/Content/comments" class="nav-link" aria-current="@(current.Contains("/Content/comments") ? "page" : null)">
        <partial name="_Icon" model='@("chat")' />Yorumlar</a>
        <a href="/Admin/Content/messages" class="nav-link" aria-current="@(current.Contains("/Content/messages") ? "page" : null)">
        <partial name="_Icon" model='@("mail")' />İletişim Mesajları</a>

    </div>
</details>
