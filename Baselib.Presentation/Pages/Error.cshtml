@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<section class="error-panel">
    <h1>İşlem tamamlanamadı</h1>
    <p class="text-muted">İstek işlenirken beklenmeyen bir hata oluştu.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mb-0">
            <strong>İstek No:</strong> <code>@Model.RequestId</code>
        </p>
    }
</section>
