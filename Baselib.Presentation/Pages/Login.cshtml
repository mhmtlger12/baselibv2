@page
@model Baselib.Presentation.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giriş - Baselib</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel" aria-labelledby="loginTitle">
            <div class="auth-brand">
                <span class="auth-brand-mark"><i class="bi bi-shield-lock"></i></span>
                <div>
                    <strong>Baselib</strong>
                    <span>Yönetim Paneli</span>
                </div>
            </div>

            <div class="auth-heading">
                <h1 id="loginTitle">Hesabınıza giriş yapın</h1>
                <p>Kurumsal yönetim modülüne devam etmek için bilgilerinizi girin.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" class="auth-form">
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">Kullanıcı Adı</label>
                    <input class="form-control" asp-for="Username" autocomplete="username" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Şifre</label>
                    <input class="form-control" asp-for="Password" type="password" autocomplete="current-password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
            </form>

            <p class="auth-switch">
                Hesabınız yok mu?
                <a asp-page="/Register">Kayıt oluşturun</a>
            </p>
        </section>
    </main>
</body>
</html>
