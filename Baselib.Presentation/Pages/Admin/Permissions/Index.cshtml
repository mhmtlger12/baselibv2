@page
@model Baselib.Presentation.Pages.Admin.Permissions.IndexModel
@{
    ViewData["Title"] = "İzinler";
}

<div class="page-toolbar">
    <div>
        <h2>İzinler</h2>
        <p>API controller izinlerini CRUD seviyesinde yönetin.</p>
    </div>
    <button class="btn btn-primary" type="button" id="openPermModal">
        <i class="bi bi-plus-lg"></i> Yeni İzin
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div id="permissionList" class="accordion"></div>
    </div>
</div>

<div class="modal fade" id="permModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Yeni İzin</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="permId" />
                <div class="mb-3">
                    <label class="form-label">İzin Adı</label>
                    <input type="text" class="form-control" id="name" required placeholder="Kullanıcı Listele" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Controller Adı</label>
                    <input type="text" class="form-control" id="controllerName" required placeholder="Users" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Action Adı</label>
                    <input type="text" class="form-control" id="actionName" required placeholder="Index" />
                </div>
                <div class="mb-3">
                    <label class="form-label">CRUD İşlem Tipi</label>
                    <div class="crud-radio-list">
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="1" id="crudView" />
                            <label class="form-check-label" for="crudView">View</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="2" id="crudAdd" />
                            <label class="form-check-label" for="crudAdd">Add</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="3" id="crudUpdate" />
                            <label class="form-check-label" for="crudUpdate">Update</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="4" id="crudPreview" />
                            <label class="form-check-label" for="crudPreview">Preview</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="5" id="crudOption" />
                            <label class="form-check-label" for="crudOption">Option</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input crud-type" type="radio" name="crudActionType" value="6" id="crudDelete" />
                            <label class="form-check-label" for="crudDelete">Delete</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Açıklama</label>
                    <input type="text" class="form-control" id="description" />
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isActive" checked />
                        <label class="form-check-label">Aktif</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="savePermButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/permissions.js" asp-append-version="true"></script>
}
