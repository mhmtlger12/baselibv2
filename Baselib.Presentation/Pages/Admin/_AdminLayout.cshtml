@inject AuthService AuthService
@inject ApiService ApiService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var currentUser = AuthService.GetCurrentUser();
    var displayName = currentUser?.FullName;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = currentUser?.Username ?? "Kullanıcı";
    }

    List<Baselib.Business.DTOs.MenuDto> userMenus = new();
    if (currentUser != null)
    {
        try
        {
            userMenus = await ApiService.GetAsync<List<Baselib.Business.DTOs.MenuDto>>($"/api/menus/user/{currentUser.Id}") ?? new();
        }
        catch
        {
            // Menüler yüklenirken hata oluşursa boş liste kalır
        }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Baselib</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body class="admin-shell">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <nav class="admin-sidebar" id="adminSidebar" aria-label="Yönetim menüsü">
        <div class="sidebar-header">
            <a class="sidebar-brand" asp-page="/Admin/Index">
                <span class="brand-mark"><i class="bi bi-shield-lock"></i></span>
                <span>Baselib</span>
            </a>
        </div>

        <ul class="sidebar-menu">
            @if (userMenus.Any())
            {
                foreach (var menu in userMenus)
                {
                    bool isActive = false;
                    var menuUrl = menu.Url ?? "";
                    if (menuUrl == "/Admin" || menuUrl == "/Admin/Index")
                    {
                        isActive = currentPage == "/Admin/Index" || currentPage == "/Admin";
                    }
                    else if (!string.IsNullOrEmpty(menuUrl))
                    {
                        isActive = currentPage.StartsWith(menuUrl);
                    }

                    <li>
                        <a class="sidebar-link @(isActive ? "active" : "")" href="@menuUrl">
                            <i class="bi @(menu.Icon ?? "bi-circle")"></i>
                            <span>@menu.Name</span>
                        </a>
                        @if (menu.SubMenus != null && menu.SubMenus.Any())
                        {
                            <ul class="sidebar-submenu" style="padding-left: 1.5rem; list-style: none;">
                                @foreach (var sub in menu.SubMenus)
                                {
                                    bool isSubActive = false;
                                    var subUrl = sub.Url ?? "";
                                    if (!string.IsNullOrEmpty(subUrl))
                                    {
                                        isSubActive = currentPage.StartsWith(subUrl);
                                    }
                                    <li>
                                        <a class="sidebar-link @(isSubActive ? "active" : "")" href="@subUrl">
                                            <i class="bi @(sub.Icon ?? "bi-circle")"></i>
                                            <span>@sub.Name</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            }
            else
            {
                <li>
                    <a class="sidebar-link" href="#">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Yetkili menü bulunamadı</span>
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <a class="sidebar-link" asp-page="/Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Çıkış</span>
            </a>
        </div>
    </nav>

    <div class="admin-frame">
        <header class="admin-header">
            <button class="icon-button d-lg-none" type="button" id="sidebarToggle" aria-label="Menüyü aç">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <div class="eyebrow">Yönetim Paneli</div>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="header-user dropdown">
                <div class="d-flex align-items-center" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="header-avatar">@(displayName[..1].ToUpperInvariant())</div>
                    <div class="header-user-text ms-2 d-none d-md-block">
                        <strong>@displayName</strong>
                        <span>@(currentUser?.ActiveRoleName ?? currentUser?.Roles.FirstOrDefault() ?? "Yetkili kullanıcı")</span>
                    </div>
                    <i class="bi bi-chevron-down ms-2 text-muted"></i>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                    <li><a class="dropdown-item py-2" asp-page="/Admin/Profile"><i class="bi bi-person me-2 text-muted"></i> Profilim</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" asp-page="/Logout"><i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap</a></li>
                </ul>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
