@inject AuthService AuthService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var currentUser = AuthService.GetCurrentUser();
    var displayName = currentUser?.FullName;
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = currentUser?.Username ?? "Kullanıcı";
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Baselib</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body class="admin-shell">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <nav class="admin-sidebar" id="adminSidebar" aria-label="Yönetim menüsü">
        <div class="sidebar-header">
            <a class="sidebar-brand" asp-page="/Admin/Index">
                <span class="brand-mark"><i class="bi bi-shield-lock"></i></span>
                <span>Baselib</span>
            </a>
        </div>

        <ul class="sidebar-menu">
            <li>
                <a class="sidebar-link @(currentPage == "/Admin/Index" ? "active" : "")" asp-page="/Admin/Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(currentPage.Contains("Users") ? "active" : "")" asp-page="/Admin/Users/Index">
                    <i class="bi bi-people"></i>
                    <span>Kullanıcılar</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(currentPage.Contains("Roles") ? "active" : "")" asp-page="/Admin/Roles/Index">
                    <i class="bi bi-shield-check"></i>
                    <span>Roller</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(currentPage.Contains("Permissions") ? "active" : "")" asp-page="/Admin/Permissions/Index">
                    <i class="bi bi-key"></i>
                    <span>İzinler</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(currentPage.Contains("Departments") ? "active" : "")" asp-page="/Admin/Departments/Index">
                    <i class="bi bi-diagram-3"></i>
                    <span>Departmanlar</span>
                </a>
            </li>
            <li>
                <a class="sidebar-link @(currentPage.Contains("Menus") ? "active" : "")" asp-page="/Admin/Menus/Index">
                    <i class="bi bi-menu-button-wide"></i>
                    <span>Menüler</span>
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <a class="sidebar-link" asp-page="/Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Çıkış</span>
            </a>
        </div>
    </nav>

    <div class="admin-frame">
        <header class="admin-header">
            <button class="icon-button d-lg-none" type="button" id="sidebarToggle" aria-label="Menüyü aç">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <div class="eyebrow">Yönetim Paneli</div>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="header-user">
                <div class="header-avatar">@(displayName[..1].ToUpperInvariant())</div>
                <div class="header-user-text">
                    <strong>@displayName</strong>
                    <span>@(currentUser?.Roles.FirstOrDefault() ?? "Yetkili kullanıcı")</span>
                </div>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/common.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
