@page
@model Baselib.Presentation.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-toolbar">
    <div>
        <h2>Genel Bakış</h2>
        <p>Kullanıcı, rol ve yetki yönetimi için özet durum.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="alert">@Model.LoadError</div>
}

<div class="row g-3">
    <div class="col-md-6 col-xl-3">
        <div class="metric-card">
            <span class="metric-icon"><i class="bi bi-people"></i></span>
            <div>
                <p class="metric-value">@Model.UserCount</p>
                <p class="metric-label">Toplam Kullanıcı</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="metric-card">
            <span class="metric-icon"><i class="bi bi-shield-check"></i></span>
            <div>
                <p class="metric-value">@Model.RoleCount</p>
                <p class="metric-label">Roller</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="metric-card">
            <span class="metric-icon"><i class="bi bi-key"></i></span>
            <div>
                <p class="metric-value">@Model.PermissionCount</p>
                <p class="metric-label">İzinler</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="metric-card">
            <span class="metric-icon"><i class="bi bi-diagram-3"></i></span>
            <div>
                <p class="metric-value">@Model.DepartmentCount</p>
                <p class="metric-label">Departmanlar</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Yönetim Kısayolları</h5>
            </div>
            <div class="card-body">
                <div class="activity-list">
                    <div class="activity-item">
                        <span class="activity-icon"><i class="bi bi-person-plus"></i></span>
                        <div>
                            <strong>Kullanıcı oluştur</strong>
                            <p class="text-muted mb-0 small">Yeni kullanıcı ekleyip rol ataması yapın.</p>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-icon"><i class="bi bi-shield-lock"></i></span>
                        <div>
                            <strong>Rol yetkilerini düzenle</strong>
                            <p class="text-muted mb-0 small">Controller bazlı CRUD izinlerini yönetin.</p>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-icon"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <strong>Organizasyonu güncelle</strong>
                            <p class="text-muted mb-0 small">Departman ağacını ve menü sıralamasını düzenleyin.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Veri Durumu</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Kullanıcı / Rol Dengesi</span>
                        <span class="text-success">@Model.UserRoleRatio%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-success" role="progressbar" aria-label="Kullanıcı rol dengesi" data-progress="@Model.UserRoleRatio"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Yetki Kapsamı</span>
                        <span class="text-warning">@Model.PermissionCoverage%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-warning" role="progressbar" aria-label="Yetki kapsamı" data-progress="@Model.PermissionCoverage"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Departman Yapısı</span>
                        <span class="text-info">@Model.DepartmentCoverage%</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-info" role="progressbar" aria-label="Departman yapısı" data-progress="@Model.DepartmentCoverage"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/admin-dashboard.js" asp-append-version="true"></script>
}
