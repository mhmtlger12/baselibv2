@page
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-md-3">
        <div class="card text-center p-4">
            <i class="bi bi-people text-primary" style="font-size: 40px;"></i>
            <h3 class="mt-3">1,234</h3>
            <p class="text-muted mb-0">Toplam Kullanıcı</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-4">
            <i class="bi bi-shield-check text-success" style="font-size: 40px;"></i>
            <h3 class="mt-3">15</h3>
            <p class="text-muted mb-0">Roller</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-4">
            <i class="bi bi-key text-warning" style="font-size: 40px;"></i>
            <h3 class="mt-3">48</h3>
            <p class="text-muted mb-0">İzinler</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-4">
            <i class="bi bi-diagram-3 text-info" style="font-size: 40px;"></i>
            <h3 class="mt-3">8</h3>
            <p class="text-muted mb-0">Departmanlar</p>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Son Aktiviteler</h5>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success rounded-circle p-2 me-3">
                        <i class="bi bi-plus text-white"></i>
                    </div>
                    <div>
                        <strong>Yeni kullanıcı eklendi</strong>
                        <p class="text-muted mb-0 small">2 saat önce</p>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary rounded-circle p-2 me-3">
                        <i class="bi bi-pencil text-white"></i>
                    </div>
                    <div>
                        <strong>Rol güncellendi</strong>
                        <p class="text-muted mb-0 small">5 saat önce</p>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <div class="bg-warning rounded-circle p-2 me-3">
                        <i class="bi bi-shield text-white"></i>
                    </div>
                    <div>
                        <strong>İzin ataması yapıldı</strong>
                        <p class="text-muted mb-0 small">1 gün önce</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Sistem Durumu</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>CPU Kullanımı</span>
                        <span class="text-success">%25</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 25%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Bellek Kullanımı</span>
                        <span class="text-warning">%62</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning" style="width: 62%"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Disk Alanı</span>
                        <span class="text-info">%45</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-info" style="width: 45%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>