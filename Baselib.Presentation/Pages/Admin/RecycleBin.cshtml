@page
@model Baselib.Presentation.Pages.Admin.RecycleBinModel
@{
    ViewData["Title"] = "Çöp Kutusu";
}

<div class="page-toolbar">
    <div>
        <h2>Çöp Kutusu (Arşiv)</h2>
        <p>Sistemden silinmiş (pasife alınmış) tüm kayıtları görüntüleyin ve gerektiğinde geri yükleyin.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 20%;">Kayıt Türü</th>
                        <th style="width: 40%;">Kayıt Adı / Tanımı</th>
                        <th style="width: 20%;">Silinme Tarihi</th>
                        <th style="width: 20%;" class="text-end">Aksiyon</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var badgeClass = item.Type == "Kullanıcı" ? "bg-primary" :
                                             item.Type == "Rol" ? "bg-warning text-dark" : "bg-info text-dark";
                            <tr>
                                <td><span class="badge @badgeClass">@item.Type</span></td>
                                <td><strong>@item.Name</strong></td>
                                <td>@(item.DeletedDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-success btn-restore" data-id="@item.Id" data-type="@item.Type">
                                        <i class="bi bi-arrow-counterclockwise"></i> Geri Yükle
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="bi bi-trash3 fs-1 text-muted d-block mb-3"></i>
                                <h5 class="text-muted">Çöp kutusu tamamen boş.</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/recyclebin.js" asp-append-version="true"></script>
}
