@page
@model Baselib.Presentation.Pages.Admin.Menus.IndexModel
@{
    ViewData["Title"] = "Menüler";
}

<div class="page-toolbar">
    <div>
        <h2>Menüler</h2>
        <p>Panel menülerini, sıralamayı ve bağlı izinleri yönetin.</p>
    </div>
    <button class="btn btn-primary" type="button" id="openMenuModal">
        <i class="bi bi-plus-lg"></i> Yeni Menü
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div id="menuTree" class="tree-view"></div>
    </div>
</div>

<div class="modal fade" id="menuModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Yeni Menü</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="menuId" />
                <div class="mb-3">
                    <label class="form-label">Menü Adı</label>
                    <input type="text" class="form-control" id="name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">URL</label>
                    <input type="text" class="form-control" id="url" placeholder="/Admin/Users" />
                </div>
                <div class="mb-3">
                    <label class="form-label">İkon (Bootstrap Icons)</label>
                    <input type="text" class="form-control" id="icon" placeholder="bi-person" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Sıra</label>
                    <input type="number" class="form-control" id="order" value="0" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Üst Menü</label>
                    <select class="form-select" id="parentId">
                        <option value="">Üst menü yok (Root)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Bağlı İzin</label>
                    <select class="form-select" id="permissionId">
                        <option value="">İzin gerektirmez</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isActive" checked />
                        <label class="form-check-label">Aktif</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary" id="saveMenuButton">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/menus.js" asp-append-version="true"></script>
}
