<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Baselib</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header-inner">
            <a class="site-brand" asp-page="/Index">Baselib</a>
            <nav class="site-nav" aria-label="Ana menü">
                <a asp-page="/Login">Giriş</a>
                <a asp-page="/Register">Kayıt</a>
            </nav>
        </div>
    </header>

    <main class="container site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>© 2026 Baselib</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
