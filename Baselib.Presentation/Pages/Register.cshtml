@page
@model Baselib.Presentation.Pages.RegisterModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kayıt - Baselib</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="auth-panel auth-panel-wide" aria-labelledby="registerTitle">
            <div class="auth-brand">
                <span class="auth-brand-mark"><i class="bi bi-building-lock"></i></span>
                <div>
                    <strong>Baselib</strong>
                    <span>Yeni Hesap</span>
                </div>
            </div>

            <div class="auth-heading">
                <h1 id="registerTitle">Kayıt oluşturun</h1>
                <p>Hesap oluşturulduktan sonra yetki ve rol ataması yönetici tarafından yapılabilir.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post" class="auth-form">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="FirstName">Ad</label>
                        <input class="form-control" asp-for="FirstName" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" asp-for="LastName">Soyad</label>
                        <input class="form-control" asp-for="LastName" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">Kullanıcı Adı</label>
                    <input class="form-control" asp-for="Username" autocomplete="username" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="form-control" asp-for="Email" type="email" autocomplete="email" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Şifre</label>
                    <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Kayıt Oluştur</button>
            </form>

            <p class="auth-switch">
                Zaten hesabınız var mı?
                <a asp-page="/Login">Giriş yapın</a>
            </p>
        </section>
    </main>
</body>
</html>
