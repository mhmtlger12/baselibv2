@page
@model Baselib.Presentation.Pages.RegisterModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kayıt - Baselib</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true">
</head>
<body class="auth-page">
    <div class="auth-split">
        <!-- Left Side: Visual Background -->
        <div class="auth-visual">
            <div class="auth-visual-content">
                <div class="glass-panel">
                    <h2>Geleceğin Parçası<br>Olun.</h2>
                    <p>Hemen kayıt olun ve yöneticinizin size yetki atamasını bekleyin. Baselib ile iş süreçlerinizi çok daha hızlı ve güvenli yönetin.</p>
                </div>
            </div>
        </div>

        <!-- Right Side: Form Area -->
        <main class="auth-content">
            <section class="auth-panel auth-panel-wide" aria-labelledby="registerTitle">
                <div class="auth-brand">
                    <div class="auth-brand-mark"><i class="bi bi-building-add"></i></div>
                    <div class="auth-brand-text">
                        <strong>Baselib</strong>
                        <span>Yeni Hesap</span>
                    </div>
                </div>

                <div class="auth-heading">
                    <h1 id="registerTitle">Aramıza Katılın</h1>
                    <p>Sisteme kayıt olmak için aşağıdaki bilgileri eksiksiz doldurun.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
                    </div>
                }

                <form method="post" class="auth-form">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="FirstName">Ad</label>
                            <input class="form-control" asp-for="FirstName" placeholder="Örn: Ahmet" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" asp-for="LastName">Soyad</label>
                            <input class="form-control" asp-for="LastName" placeholder="Örn: Yılmaz" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Username">Kullanıcı Adı</label>
                        <input class="form-control" asp-for="Username" autocomplete="username" placeholder="Sisteme giriş için kullanıcı adı" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Email">Email Adresi</label>
                        <input class="form-control" asp-for="Email" type="email" autocomplete="email" placeholder="ornek@sirket.com" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" asp-for="Password">Şifre</label>
                        <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" placeholder="••••••••" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Kayıt Oluştur</button>
                </form>

                <p class="auth-switch">
                    Zaten hesabınız var mı?
                    <a asp-page="/Login">Giriş yapın</a>
                </p>
            </section>
        </main>
    </div>
</body>
</html>
